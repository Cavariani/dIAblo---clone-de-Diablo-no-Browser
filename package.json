{
  "name": "diablopus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Diablopus — ARPG isométrico 2D para browser inspirado em Diablo 3/4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "assets": "node scripts/assets/build-assets.mjs"
  },
  "dependencies": {
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
